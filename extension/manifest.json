{
  "manifest_version": 3,
  "name": "Doublage FR",
  "version": "0.1.0",
  "description": "Écoute les vidéos YouTube et X en français : coupe le son d'origine et joue une voix française synchronisée (serveur local).",
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
